                                "kind": "text",
                                "value": "QUALITY",
                              },
                            ],
                            "kind": "primitive",
                            "props": {
                              "style": {
                                "color": "#1A1A1A",
                                "fontSize": 8.5,
                                "fontWeight": "bold",
                                "letterSpacing": 2.5,
