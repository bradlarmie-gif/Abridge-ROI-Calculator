                            "kind": "text",
                            "value": "staffed beds",
                          },
                        ],
                        "kind": "primitive",
                        "props": {
                          "style": {
                            "color": "#1A1A1A",
                            "fontWeight": "bold",
                          },
                        },
                        "tag": "TEXT",
                      },
                      {
                        "kind": "text",
                        "value": " anchor the math to your actual operating footprint.",
                      },
                    ],
                    "kind": "primitive",
                    "props": {
                      "style": {
                        "color": "#666666",
                        "fontSize": 10.5,
                        "lineHeight": 1.5,
                        "marginBottom": 12,
                      },
                    },
                    "tag": "TEXT",
                  },
                  {
                    "children": [
                      {
                        "kind": "text",
                        "value": "We deliberately don't price capacity. Translating reclaimed minutes into dollars requires assumptions about what the next hour gets used for — assumptions that vary by unit, shift, and patient mix. Tracking the leading indicator is more defensible than monetizing it.",
                      },
